# Copy this file to .env.local (already gitignored via the *.local pattern)
# and fill in a real key to enable live Google Maps for the Flood Evacuation
# feature. Never commit a real key — .env.local stays local to your machine.
#
# Required Google Cloud APIs (enable these on the project the key belongs to):
#   - Maps JavaScript API
#   - Places API
#   - Directions API
#   - Elevation API
#
# If this is left blank, the Flood Evacuation screen runs entirely on local
# demo data instead — see src/data/evacuationDemo.ts and the README section
# "Flood Evacuation (Google Maps)".
VITE_GOOGLE_MAPS_API_KEY=
